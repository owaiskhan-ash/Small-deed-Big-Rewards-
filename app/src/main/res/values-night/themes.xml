<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark glyphs are invisible on the near-black (#141210) status bar, so
         request light glyphs in night mode. Compose re-applies the correct
         value for forced themes once it is running. -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
